# PostgreSQL 16 bootstrap
POSTGRES_DB=
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_PORT=

# Process-specific database connections
MIGRATION_DATABASE_URL=
API_DATABASE_URL=
REMINDER_WORKER_DATABASE_URL=

# Public Telegram bot identifier
TELEGRAM_BOT_ID=

# API process. BOT_TOKEN is absent on purpose and the process refuses to start
# when it is present: only the bot and the reminder worker may hold it.
APP_ENV=
WEBAPP_URL=
TELEGRAM_ED25519_PUBLIC_KEY=
LOG_ACCOUNT_REF_KEY=
AUTH_MIN_AUTH_DATE=
AUTH_HMAC_FALLBACK_ENABLED=
WEBAPP_HMAC_SECRET=

# Erasure journal (§6.4, §6.5). Обовʼязковий поза розробкою: він живе в іншого
# провайдера й іншої країни, ніж БД і бекапи. Імені бакета, хоста й облікових
# даних тут немає і не буде — операційна частина резидентності в git не живе.
# Ключі — 32 байти hex кожен, і вони мусять бути різними: той, хто перевіряє
# денний head, не має заразом уміти обчислити посилання для названого акаунта.
ERASURE_JOURNAL_ENABLED=
ERASURE_JOURNAL_KEY=
ERASURE_JOURNAL_HEAD_KEY=
ERASURE_JOURNAL_PREFIX=

# Момент першого розгортання, ISO-8601 з офсетом. §6.4 рахує з нього покриття
# restore як min(now − SERVICE_START_AT, 90 днів). Ставиться один раз і ніколи
# не змінюється: пізніше значення скорочує покриття й блокує відновлення.
SERVICE_START_AT=

# Паролі ролей застосунку. Міграція створює ролі без паролів, щоб секрет не
# опинився в git; ./scripts/dev-stand.sh виставляє їх і збирає DSN вище.
API_RW_PASSWORD=
REMINDER_WORKER_PASSWORD=
